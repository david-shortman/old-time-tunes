{
  "name": "ott-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ott-app",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/next:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "apps/ott-app"
      },
      "configurations": {
        "development": {
          "outputPath": "apps/ott-app"
        },
        "production": {}
      },
      "dependsOn": [
        "copy-assets",
        "^build"
      ]
    },
    "serve": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "ott-app:build",
        "dev": true
      },
      "configurations": {
        "development": {
          "buildTarget": "ott-app:build:development",
          "dev": true
        },
        "production": {
          "buildTarget": "ott-app:build:production",
          "dev": false
        }
      },
      "dependsOn": [
        "copy-assets"
      ]
    },
    "export": {
      "executor": "@nx/next:export",
      "options": {
        "buildTarget": "ott-app:build:production"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/ott-app/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "copy-assets": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/public/ort",
        "{projectRoot}/public/model"
      ],
      "options": {
        "commands": [
          "mkdir -p apps/ott-app/public/ort apps/ott-app/public/model",
          "cp node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.mjs apps/ott-app/public/ort/",
          "cp node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.jsep.wasm node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.jsep.mjs apps/ott-app/public/ort/",
          "cp libs/ts/transcribe/model/nmp.onnx apps/ott-app/public/model/"
        ],
        "parallel": false
      }
    }
  }
}
