# Copy to .env.local (git-ignored). Values come from the Firebase console:
# Project settings → Your apps → Web app → SDK setup and configuration,
# or `firebase apps:sdkconfig web --project <project-id>`.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Set to 1 to talk to the local Emulator Suite (`npx nx run ott-app:emulators`)
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=
