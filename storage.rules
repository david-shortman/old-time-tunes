rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // variants/{variantId}/audio.{ext}; visibility and owner are copied onto object metadata at upload
    match /variants/{variantId}/{file} {
      allow read: if resource.metadata.visibility == 'public'
               || (request.auth != null && resource.metadata.ownerUid == request.auth.uid);
      allow write: if request.auth != null
               && request.resource.metadata.ownerUid == request.auth.uid
               && request.resource.metadata.visibility in ['private', 'public']
               && request.resource.contentType.matches('audio/.*')
               && request.resource.size <= 50 * 1024 * 1024;
      allow delete: if request.auth != null && resource.metadata.ownerUid == request.auth.uid;
    }
  }
}
